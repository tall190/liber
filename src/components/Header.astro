---
import { Image } from 'astro:assets';
import logoSrc from '../assets/liber-logo.png';
import HeaderLink from './HeaderLink.astro';

// Normalize BASE_URL: strip trailing slash so we can always append '/' explicitly
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header>
	<nav>
		<h2><a href={`${base}/`}><Image src={logoSrc} alt="Liber" height={40} densities={[1, 2, 3]} quality={100} /></a></h2>
		<div class="internal-links">
			<HeaderLink href={`${base}/`}>Home</HeaderLink>
			<HeaderLink href={`${base}/blog/`}>Blog</HeaderLink>
			<HeaderLink href={`${base}/about/`}>About</HeaderLink>
			<button class="theme-toggle" id="theme-toggle" aria-label="다크 모드 전환">
				<svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
				<svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
			</button>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--header-bg);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		transition: background-color 0.3s;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.theme-toggle {
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5em;
		color: rgb(var(--black));
		display: flex;
		align-items: center;
		transition: color 0.3s;
	}
	.theme-toggle:hover {
		color: var(--accent);
	}
	:global(.dark) .icon-sun { display: inline; }
	:global(.dark) .icon-moon { display: none; }
	.icon-sun { display: none; }
	.icon-moon { display: inline; }
</style>
